    if (a == 5) {
        print("five!");
    } elseif (a > 5) {
        print("big!");
    } else {
        print("small!");
    }
    for (int i = 0; i < 3; i++) {
        print("%d", i);
    }
    while (a < 7) {
        print("%d", a);
        a = 99;
    }
    loop(task.time, 5, 1) {
        print("loop!");
    }
    print("the end!");
    the end;
}