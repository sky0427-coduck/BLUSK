import blusk26;
import io;

@entry
Blusk public void main() {
    gg[] nums = {1, 2, 3, 4, 5};

    print(f"first  = {nums[0]}");
    print("size = %d", size.nums);

    nums[2] = 99;
    print(f"after set, nums[2] = {nums[2]}");

    gg total = 0;
    for (gg i = 0; i < 5; i++) {
        total = total + nums[i];
    };
    print(f"total = {total}");

    the end;
}
